++		BPF_STMT(BPF_LD + BPF_H + BPF_ABS, 22 /* dst port */),
++		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, port, 0, 1),
++		BPF_STMT(BPF_RET + BPF_K, -1),
++		BPF_STMT(BPF_RET + BPF_K, 0)
++	};
