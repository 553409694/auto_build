++	bool found = false;
++
++	char *ifaces = cmd_ret(&c, "wg show interfaces");
++	if (ifaces) {
++		for (char *eiface = strtok(ifaces, " \n"); eiface; eiface = strtok(NULL, " \n")) {
++			if (!strcmp(iface, eiface)) {
++				found = true;
++				break;
++			}
++		}
++	}
++	if (!found) {
++		fprintf(stderr, "Error: %s is not a WireGuard interface\n", iface);
