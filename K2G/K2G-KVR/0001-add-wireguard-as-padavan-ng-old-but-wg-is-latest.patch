++	limb *nqpqx = a, *nqpqz = b, *nqx = c, *nqz = d, *t;
++	limb e[19] = {0}, f[19] = {1}, g[19] = {0}, h[19] = {1};
++	limb *nqpqx2 = e, *nqpqz2 = f, *nqx2 = g, *nqz2 = h;
++
