++_printf_(1, 2) static void cmd(const char *cmd_fmt, ...)
++{
++	_cleanup_free_ char *cmd = NULL;
++	va_list args;
++	int ret;
++
++	va_start(args, cmd_fmt);
++	if (vasprintf(&cmd, cmd_fmt, args) < 0) {
++		perror("Error: vasprintf");
++		exit(errno);
++	}
++	va_end(args);
++
++	printf("[#] %s\n", cmd);
++	ret = system(cmd);
++
++	if (ret < 0)
++		ret = ESRCH;
++	else if (ret > 0)
++		ret = WIFEXITED(ret) ? WEXITSTATUS(ret) : EIO;
