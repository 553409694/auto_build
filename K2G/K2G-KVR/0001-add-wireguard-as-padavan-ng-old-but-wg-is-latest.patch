++/* A useful OpenBSD-ism. */
++static void *realloc_array(void *optr, size_t nmemb, size_t size)
++{
++	if ((nmemb >= (size_t)1 << (sizeof(size_t) * 4) ||
++	     size >= (size_t)1 << (sizeof(size_t) * 4)) &&
++	    nmemb > 0 && SIZE_MAX / nmemb < size) {
++		errno = ENOMEM;
++		return NULL;
++	}
++	return realloc(optr, size * nmemb);
