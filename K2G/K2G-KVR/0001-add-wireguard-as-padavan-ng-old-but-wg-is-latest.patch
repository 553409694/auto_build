++	t[1] += ((uint128_t) r4) * s2 + ((uint128_t) r2) * s4 + ((uint128_t) r3) * s3;
++	t[2] += ((uint128_t) r4) * s3 + ((uint128_t) r3) * s4;
++	t[3] += ((uint128_t) r4) * s4;
