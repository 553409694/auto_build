++/* int32_t_eq returns 0xffffffff iff a == b and zero otherwise. */
++static int32_t int32_t_eq(int32_t a, int32_t b)
++{
++	a = ~(a ^ b);
++	a &= a << 16;
++	a &= a << 8;
++	a &= a << 4;
++	a &= a << 2;
++	a &= a << 1;
++	return a >> 31;
++}
