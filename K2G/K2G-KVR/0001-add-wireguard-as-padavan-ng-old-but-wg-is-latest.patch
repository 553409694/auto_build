++		if (!allowedip)
++			peer->first_allowedip = peer->next_peer->first_allowedip;
++		else
++			allowedip->next_allowedip = peer->next_peer->first_allowedip;
++		old_next_peer = peer->next_peer;
++		peer->next_peer = old_next_peer->next_peer;
