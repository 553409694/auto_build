+-	fe_mul_ttt(&t1, &t1, &t2);
+-	fe_sq_tt(&t2, &t1);
+-	for (i = 1; i < 5; ++i)
+-		fe_sq_tt(&t2, &t2);
+-	fe_mul_ttt(&t1, &t2, &t1);
+-	fe_sq_tt(&t2, &t1);
+-	for (i = 1; i < 10; ++i)
+-		fe_sq_tt(&t2, &t2);
+-	fe_mul_ttt(&t2, &t2, &t1);
+-	fe_sq_tt(&t3, &t2);
+-	for (i = 1; i < 20; ++i)
+-		fe_sq_tt(&t3, &t3);
