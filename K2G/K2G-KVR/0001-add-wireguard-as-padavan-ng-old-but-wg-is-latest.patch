++		return show_main(1, new_argv);
++	}
++
++findsubcommand:
++	for (size_t i = 0; i < sizeof(subcommands) / sizeof(subcommands[0]); ++i) {
++		if (!strcmp(argv[1], subcommands[i].subcommand))
++			return subcommands[i].function(argc - 1, argv + 1);
