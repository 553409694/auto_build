++	spans = highlight_config(input);
++
++	fputs(TERMINAL_RESET, stdout);
++	for (struct highlight_span *span = spans; span->type != HighlightEnd; ++span) {
++		fwrite(input + last, 1, span->start - last, stdout);
++		fputs(colormap[span->type], stdout);
