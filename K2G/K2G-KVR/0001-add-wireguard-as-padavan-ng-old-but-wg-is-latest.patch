+static char *concat(char *first, ...)
+{
+	va_list args;
+	size_t len = 0;
+	char *ret;
+
+	va_start(args, first);
+	for (char *i = first; i; i = va_arg(args, char *))
+		len += strlen(i);
+	va_end(args);
+
+	ret = xmalloc(len + 1);
+	ret[0] = '\0';
+
+	va_start(args, first);
+	for (char *i = first; i; i = va_arg(args, char *))
+		strcat(ret, i);
+	va_end(args);
+
+	return ret;
+}
