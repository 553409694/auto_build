++static int mnl_cb_run(const void *buf, size_t numbytes, unsigned int seq,
++		      unsigned int portid, mnl_cb_t cb_data, void *data)
++{
++	return __mnl_cb_run(buf, numbytes, seq, portid, cb_data, data, NULL, 0);
