++	/* 2^52 - 2^2 */ fsquare(t1,t0);
++	/* 2^100 - 2^50 */ for (i = 2; i < 50; i += 2) { fsquare(t0,t1); fsquare(t1,t0); }
++	/* 2^100 - 2^0 */ fmul(z2_100_0,t1,z2_50_0);
