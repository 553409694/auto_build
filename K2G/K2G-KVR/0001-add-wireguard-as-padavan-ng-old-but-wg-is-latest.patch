++		arg = args;
++		for (; !arg[0]; ++arg);
++		arg += strlen(arg) + 1;
++		for (; !arg[0]; ++arg);
++		arg += strlen(arg) + 1;
++		len = data_len - (arg - args);
++		if (len <= 1)
++			goto done;
++		assert((fake_stdin = fmemopen(arg, len - 1, "r")));
++		stdin = fake_stdin;
++	}
++	wg_main(argc, argv);
++done:
++	for (size_t i = 0; i < argc; ++i)
++		free(argv[i]);
++	free(args);
++	if (fake_stdin)
++		fclose(fake_stdin);
++	return 0;
++}
