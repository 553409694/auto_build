+ 		return;
+ #endif
+ 	fd = open("/dev/urandom", O_RDONLY);
+ 	assert(fd >= 0);
+-	ret = read(fd, preshared_key, sizeof(wg_key));
++	for (i = 0; i < sizeof(wg_key); i += ret) {
++		ret = read(fd, preshared_key + i, sizeof(wg_key) - i);
