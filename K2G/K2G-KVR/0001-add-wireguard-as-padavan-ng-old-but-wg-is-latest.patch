+-			  - (((61 - input[i]) >> 8) & 15)
+-			  + (((62 - input[i]) >> 8) & 3);
+-
+-}
+-
+-EMSCRIPTEN_KEEPALIVE void key_to_base64(char base64[static 45], const u8 key[static 32])
+-{
+-	unsigned int i;
+-
+-	for (i = 0; i < 32 / 3; ++i)
