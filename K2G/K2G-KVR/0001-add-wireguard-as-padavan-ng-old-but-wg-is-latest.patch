++{
++	unsigned int i;
++
++	for (i = 0; i < 32 / 3; ++i)
++		encode_base64(&base64[i * 4], &key[i * 3]);
++	encode_base64(&base64[i * 4], (const u8[]){ key[i * 3 + 0], key[i * 3 + 1], 0 });
++	base64[45 - 2] = '=';
++	base64[45 - 1] = '\0';
++}
