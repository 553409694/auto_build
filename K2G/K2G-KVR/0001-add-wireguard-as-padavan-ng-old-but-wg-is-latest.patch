+-/* Replace (f,g) with (g,f) if b == 1;
+- * replace (f,g) with (f,g) if b == 0.
+- *
+- * Preconditions: b in {0,1}
+- */
+-static __always_inline void fe_cswap(fe *f, fe *g, unsigned int b)
+-{
+-	unsigned i;
+-	b = 0-b;
+-	for (i = 0; i < 10; i++) {
+-		uint32_t x = f->v[i] ^ g->v[i];
+-		x &= b;
+-		f->v[i] ^= x;
+-		g->v[i] ^= x;
+-	}
+-}
