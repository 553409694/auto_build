+ 	"golang.org/x/net/ipv4"
+ )
+ 
++func ipChecksum(buf []byte) uint16 {
++	sum := uint32(0)
++	for ; len(buf) >= 2; buf = buf[2:] {
++		sum += uint32(buf[0])<<8 | uint32(buf[1])
++	}
++	if len(buf) > 0 {
++		sum += uint32(buf[0]) << 8
++	}
++	for sum > 0xffff {
++		sum = (sum >> 16) + (sum & 0xffff)
++	}
++	csum := ^uint16(sum)
++	if csum == 0 {
++		csum = 0xffff
++	}
++	return csum
++}
