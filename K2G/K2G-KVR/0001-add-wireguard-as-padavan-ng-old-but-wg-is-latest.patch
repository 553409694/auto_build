++		return errno == ENOENT ? 0 : -errno;
++	while ((ent = readdir(dir))) {
++		len = strlen(ent->d_name);
++		if (len <= strlen(SOCK_SUFFIX))
++			continue;
++		end = &ent->d_name[len - strlen(SOCK_SUFFIX)];
++		if (strncmp(end, SOCK_SUFFIX, strlen(SOCK_SUFFIX)))
