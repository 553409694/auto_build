++/* int32_t_gte returns 0xffffffff if a >= b and zero otherwise, where a and b are
++ * both non-negative. */
++static int32_t int32_t_gte(int32_t a, int32_t b)
++{
++	a -= b;
++	/* a >= 0 iff a >= b. */
++	return ~(a >> 31);
++}
