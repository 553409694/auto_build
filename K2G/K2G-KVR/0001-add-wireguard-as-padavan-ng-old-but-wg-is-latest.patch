++		struct highlight_span *resized;
++
++		a->capacity = a->capacity ? a->capacity * 2 : 64;
++		resized = realloc_array(a->spans, a->capacity, sizeof(*resized));
++		if (!resized) {
++			free(a->spans);
++			memset(a, 0, sizeof(*a));
++			return false;
++		}
++		a->spans = resized;
++	}
++	a->spans[a->len++] = (struct highlight_span){ t, s.s - o, s.len };
